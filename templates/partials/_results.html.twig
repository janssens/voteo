{# Résultats d'une question. Variables : question, answer
   (prénoms des votants et des personnes en attente masqués si la question est anonyme) #}
{% set total = question.nbOfResponses %}
{% set my_choice_ids = answer.choices.toArray|map(c => c.id) %}

<div class="text-center">
    <p class="stat">
        <span>{{ total }} réponse{{ total > 1 ? 's' }} reçue{{ total > 1 ? 's' }}</span>
        <span>Participation : {{ question.responseRate|format_number(style: 'percent') }}</span>
    </p>
</div>

<div class="results">
    {% for choice in question.choices %}
        {% set count = choice.answers|length %}
        {% set percent = total > 0 ? (count / total * 100)|round : 0 %}
        {% set mine = choice.id in my_choice_ids %}
        <div class="result">
            <div class="result-head">
                <span>{{ choice.label }}{% if mine %} <span class="muted">· votre choix</span>{% endif %}</span>
                <span class="count">{{ count }} · {{ percent }} %</span>
            </div>
            <div class="result-bar" role="img" aria-label="{{ percent }} % des réponses">
                <span style="width: {{ percent }}%;{% if choice.color %} background: {{ choice.color }};{% endif %}"></span>
            </div>
            {% if choice.answers is not empty and not question.anonymous %}
                <ul class="result-names">
                    {% for a in choice.answers %}
                        <li>{{ a.contact.firstname }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    {% endfor %}
</div>

{# Before closing, and only if answers are not anonymous: who has not answered yet #}
{% if not question.anonymous and not question.closed %}
    {% set pending = question.answers|filter(a => a.choices is empty)|map(a => a.contact.firstname)|sort((x, y) => x|lower <=> y|lower) %}
    {% if pending is not empty %}
        <div class="results-pending">
            <p class="results-pending-title">En attente de réponse ({{ pending|length }})</p>
            <ul class="result-names">
                {% for firstname in pending %}
                    <li>{{ firstname }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endif %}

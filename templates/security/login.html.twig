{% extends 'base.html.twig' %}
{% import 'partials/_icons.html.twig' as icon %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="container form-page">
    <section class="card form-card" aria-labelledby="login-title">
        <header class="form-card-header">
            <div class="icon-bubble">{{ icon.lock }}</div>
            <h1 id="login-title" class="h2">Bon retour parmi nous</h1>
            <p>Connectez-vous pour gérer vos questions et vos listes de contacts.</p>
        </header>

        {% if error %}
            <div class="alert alert-error" role="alert">
                <span>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                    {% if error.messageKey == constant('App\\Security\\UserChecker::UNVERIFIED_MESSAGE') %}
                        <a href="{{ path('app_verify_resend') }}">Renvoyer l'email de confirmation</a>
                    {% endif %}
                </span>
            </div>
        {% endif %}

        {% if app.user %}
            <div class="alert alert-info">
                <span>Vous êtes connecté·e en tant que <strong>{{ app.user.userIdentifier }}</strong>. <a href="{{ path('app_logout') }}">Se déconnecter</a></span>
            </div>
        {% endif %}

        <form method="post">
            <div class="form-row">
                <label class="form-label required" for="inputUsername">Nom d'utilisateur</label>
                <input type="text" value="{{ last_username }}" name="username" id="inputUsername" class="form-control" autocomplete="username" required autofocus>
            </div>

            <div class="form-row">
                <label class="form-label required" for="inputPassword">Mot de passe</label>
                <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-row">
                <label class="form-check">
                    <input type="checkbox" name="_remember_me">
                    <span>Se souvenir de moi</span>
                </label>
            </div>

            <div class="form-actions">
                <button class="btn btn-lg btn-block" type="submit">Se connecter</button>
            </div>
        </form>

        <footer class="form-footer">
            <p><a href="{{ path('app_verify_resend') }}">Vous n'avez pas reçu l'email de confirmation ?</a></p>
            <p>Pas encore de compte ? C'est gratuit.</p>
            <a href="{{ path('app_register') }}">Créer un compte</a>
        </footer>
    </section>
</div>
{% endblock %}

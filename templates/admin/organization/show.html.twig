{% extends '@EasyAdmin/page/content.html.twig' %}

{# Fiche de l'organisation active. Context : organization, memberships (triés), invitations (récentes d'abord), can_leave (plus d'un membre). #}
{% block content_title %}{{ organization.name }}{% endblock %}

{% block page_actions %}
    <a class="btn btn-secondary" href="{{ path('admin_organization_edit') }}"><i class="fa fa-pen"></i> Modifier</a>
{% endblock %}

{% block main %}
    <div class="vt-narrow-panel">
        <dl class="vt-org-details">
            <dt>Email de contact</dt>
            <dd>
                <a href="mailto:{{ organization.contactEmail }}">{{ organization.contactEmail }}</a>
                <div class="form-text">Adresse de réponse des emails envoyés au nom de l'organisation.</div>
            </dd>
            <dt>Créée le</dt>
            <dd>{{ organization.createdAt|format_date('long', locale: 'fr') }}</dd>
        </dl>

        <h2 class="h4 mt-5">Membres <span class="badge badge-secondary">{{ memberships|length }}</span></h2>
        <p class="text-muted">Tous les membres ont les mêmes droits. Un membre retiré perd l'accès, mais ses listes et questions restent à l'organisation.</p>

        <table class="table datagrid">
            <thead>
                <tr><th>Nom</th><th>Email</th><th>Membre depuis</th><th></th></tr>
            </thead>
            <tbody>
                {% for membership in memberships %}
                    {% set member = membership.user %}
                    {% set is_self = member == app.user %}
                    <tr>
                        <td>{{ member.fullName }}{% if is_self %} <span class="badge badge-info">vous</span>{% endif %}</td>
                        <td>{{ member.email }}</td>
                        <td>
                            {{ membership.joinedAt|format_date('medium', locale: 'fr') }}
                            {% if membership.invitedBy %}<div class="form-text">invité·e par {{ membership.invitedBy.fullName }}</div>{% endif %}
                        </td>
                        <td class="text-end">
                            {% if can_leave %}
                                <form method="post" action="{{ path('admin_organization_member_remove', {membershipId: membership.id}) }}"
                                      onsubmit="return confirm({{ (is_self
                                          ? 'Quitter « ' ~ organization.name ~ ' » ? Vous n\'aurez plus accès à ses listes et questions.'
                                          : 'Retirer ' ~ member.fullName ~ ' de l\'organisation ?')|json_encode(constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }})">
                                    <input type="hidden" name="_token" value="{{ csrf_token('member_remove_' ~ membership.id) }}">
                                    <button type="submit" class="btn btn-sm {{ is_self ? 'btn-secondary' : 'btn-danger' }}">
                                        {{ is_self ? 'Quitter l\'organisation' : 'Retirer' }}
                                    </button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {% if not can_leave %}
            <p class="form-text">Vous êtes le seul membre : invitez quelqu'un (ci-dessous) avant de pouvoir quitter l'organisation, ou supprimez-la.</p>
        {% endif %}

        <h2 class="h4 mt-5">Inviter quelqu'un</h2>
        <p class="text-muted">
            La personne reçoit un email avec un lien valable 7 jours. Elle se connecte, ou crée un compte si elle n'en a pas,
            puis accepte l'invitation. Elle aura alors les mêmes droits que vous.
        </p>
        <form method="post" action="{{ path('admin_organization_invite') }}" class="vt-invite-form">
            <input type="hidden" name="_token" value="{{ csrf_token('organization_invite') }}">
            <label class="visually-hidden" for="invite_email">Adresse email</label>
            <input class="form-control" type="email" id="invite_email" name="email" required maxlength="255" autocomplete="off" placeholder="prenom.nom@exemple.fr">
            <button type="submit" class="btn btn-primary"><i class="fa fa-paper-plane"></i> Envoyer l'invitation</button>
        </form>

        {% if invitations is not empty %}
            <h3 class="h5 mt-4">Invitations en attente <span class="badge badge-secondary">{{ invitations|length }}</span></h3>
            <table class="table datagrid">
                <thead>
                    <tr><th>Email</th><th>Invitée par</th><th>Lien valable jusqu'au</th><th></th></tr>
                </thead>
                <tbody>
                    {% for invitation in invitations %}
                        <tr>
                            <td>{{ invitation.email }}</td>
                            <td>{{ invitation.invitedBy ? invitation.invitedBy.fullName : '—' }}</td>
                            <td>
                                {% if invitation.expired %}
                                    <span class="badge badge-warning">expirée</span>
                                {% else %}
                                    {{ invitation.expiresAt|format_datetime('medium', 'short', locale: 'fr') }}
                                {% endif %}
                            </td>
                            <td class="text-end text-nowrap">
                                <form method="post" class="d-inline" action="{{ path('admin_organization_invitation_resend', {invitationId: invitation.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('invitation_resend_' ~ invitation.id) }}">
                                    <button type="submit" class="btn btn-sm btn-secondary">Renvoyer</button>
                                </form>
                                <form method="post" class="d-inline" action="{{ path('admin_organization_invitation_cancel', {invitationId: invitation.id}) }}"
                                      onsubmit="return confirm({{ ('Annuler l\'invitation de ' ~ invitation.email ~ ' ?')|json_encode(constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }})">
                                    <input type="hidden" name="_token" value="{{ csrf_token('invitation_cancel_' ~ invitation.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">Annuler</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        <section class="vt-danger-zone mt-5">
            <h2 class="h4">Supprimer l'organisation</h2>
            <p>
                Toutes ses listes, contacts, questions et réponses seront <strong>définitivement supprimés</strong>,
                pour tous les membres. Pour confirmer, saisissez le nom de l'organisation.
            </p>
            <form method="post" action="{{ path('admin_organization_delete') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('organization_delete') }}">
                <label class="form-label" for="confirm_name">Nom de l'organisation</label>
                <input class="form-control mb-3" type="text" id="confirm_name" name="confirm_name" required autocomplete="off" placeholder="{{ organization.name }}">
                <button type="submit" class="btn btn-danger">Supprimer définitivement</button>
            </form>
        </section>
    </div>
{% endblock %}

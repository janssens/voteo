{% extends 'base.html.twig' %}
{% import 'partials/_icons.html.twig' as icon %}

{% block title %}Merci {{ contact.firstname }} !{% endblock %}

{% block body %}
<div class="container narrow">
    <section class="card">
        <header class="text-center">
            <div class="icon-bubble mint" style="margin: 0 auto 1rem;">{{ icon.check }}</div>
            <h1 class="h2">Merci {{ contact.firstname }} !</h1>
            {% if already_answered|default(false) %}
                <div class="alert alert-notice answer-notice">
                    <span>Vous avez déjà répondu à cette question.</span>
                    {% if not question.closed %}
                        <a class="btn btn-sm btn-soft" href="{{ path('answer_form', {a_token: answer.token}) }}">Modifier ma réponse</a>
                    {% endif %}
                </div>
            {% else %}
                <p class="muted">Votre réponse à « {{ question.subject|personalize(contact, false) }} » a bien été prise en compte.</p>
            {% endif %}
        </header>

        {% include 'partials/_results.html.twig' %}

        <div class="close-page text-center">
            <p class="muted">Vous pouvez fermer cette page.</p>
            <button type="button" class="btn btn-soft" data-close-page>Fermer cette page</button>
            <p class="muted close-fallback" hidden>Votre navigateur ne permet pas de fermer cet onglet automatiquement. Vous pouvez le fermer vous-même.</p>
        </div>
        <script>
            document.querySelector('[data-close-page]').addEventListener('click', function () {
                window.close();
                // Les navigateurs refusent window.close() sur un onglet qu'ils n'ont pas ouvert par script.
                setTimeout(function () {
                    document.querySelector('.close-fallback').hidden = false;
                }, 300);
            });
        </script>
    </section>
</div>
{% endblock %}
